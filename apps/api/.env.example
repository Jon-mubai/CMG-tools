NODE_ENV=development
PORT=3001

# PostgreSQL 连接（必须与本机实际账号一致）
# 格式：postgresql://用户名:密码@主机:端口/数据库名?schema=public
# 例：用户 postgres、密码 postgres、库 wms
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wms?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=12h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# JSON 请求体上限（含 base64 图片）
BODY_LIMIT=200mb

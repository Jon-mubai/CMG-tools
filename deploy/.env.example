# Frontend static port
FRONTEND_PORT=8080
BACKEND_PORT=3001
API_PREFIX=/api/v1

CMG_CONTACT_ADMIN_URL=https://example.com/contact
CMG_APP_NAME=WMS-Tec
CMG_API_MODE_DEFAULT=local

NODE_ENV=development
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
CMG_USE_COOKIE=1
CMG_LOGIN_RATE=20
CMG_SESSION_IDLE_MS=1800000
CMG_MAX_SESSIONS=5
CMG_PREFER_SERVER_LOGIN=0
